# Runtime client configuration, BUNDLED as a Flutter asset (see pubspec.yaml).
#
# This file is committed on purpose, unlike a server app's .env. A Flutter client
# bundle ships to every user's device and can be read out of it, so nothing here
# can be secret by construction: these are public client values. It is committed
# because the asset must exist for `flutter build` to succeed, and a boilerplate
# whose fresh clone cannot build is useless.
#
# Real secrets belong on the backend, never in a client bundle.
APP_NAME=Depools
APP_ENV=local
APP_DEBUG=true

# Empty by default. Generate one per fork with `magic key:generate` if the app
# uses the Crypt facade; magic only requires it when encryption is registered.
APP_KEY=

API_URL=http://localhost:8000/api/v1
