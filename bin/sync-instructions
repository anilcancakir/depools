#!/usr/bin/env bash
#
# Mirrors this project's path-scoped Claude rules into the files GitHub Copilot reads.
#
#   bin/sync-instructions           regenerate the mirrors
#   bin/sync-instructions --check   fail if a mirror is out of date (CI uses this)
#
# WHY THESE ARE COPIES AND NOT SYMLINKS
#
# The path-scoped rules cannot be symlinked, because the two ecosystems spell the
# glob differently: `.claude/rules/*.md` uses a YAML list under `paths:`, and
# Copilot uses a single comma-separated string under `applyTo:`. So they are
# generated content, committed to the repo, guarded by `--check` in CI.
#
# AGENTS.md needs no mirror at all. Copilot code review reads it directly, and
# `CLAUDE.md` is a symlink to it, which Anthropic documents and which is safe
# because Claude Code only ever looks up `CLAUDE.md`. See the note further down
# for the surface that loses out, and what to do if it shows.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

SOURCE="AGENTS.md"
RULES_DIR=".claude/rules"

# Generate everything into a staging tree first, so --check has something to diff
# and a real run cannot leave a half-written mirror behind.
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/.github/instructions"

banner() {
    printf '<!-- GENERATED from %s by bin/sync-instructions. Edit that file, not this one. -->\n' "$1"
}

# THERE IS NO REPO-WIDE MIRROR, AND ITS ABSENCE IS A DECISION.
#
# This script used to also write `.github/copilot-instructions.md`, a full copy of AGENTS.md.
# GitHub's own documentation now lists AGENTS.md among the files Copilot code review reads, next
# to the path-scoped instructions, so the copy was the same content twice in one review's context.
#
# Accepted cost: Copilot Chat in the IDE is documented to read `copilot-instructions.md` and is NOT
# documented to read AGENTS.md, so that surface may now get less project context. It fails softly, by
# answering more generically rather than by erroring, which is exactly why this note is here: if
# Chat starts giving answers that ignore this project's conventions, restoring the copy is the first
# thing to try, not the last.

# One path-scoped mirror per rule. `paths:` is a YAML list of quoted globs;
# `applyTo:` is one comma-separated string.
for rule in "$RULES_DIR"/*.md; do
    [ -e "$rule" ] || continue
    topic="$(basename "$rule" .md)"
    target="$STAGE/.github/instructions/$topic.instructions.md"

    globs="$(
        awk '
            NR == 1 && $0 == "---" { inside = 1; next }
            inside && $0 == "---" { exit }
            inside && match($0, /^[[:space:]]*-[[:space:]]*"[^"]+"/) {
                line = $0
                sub(/^[^"]*"/, "", line)
                sub(/".*$/, "", line)
                printf "%s%s", sep, line
                sep = ","
            }
        ' "$rule"
    )"

    # Fatal, not a skip: a skipped rule whose mirror was never committed leaves the
    # staging tree and .github/instructions in agreement, so --check would report
    # "up to date" while a whole path-scoped rule is invisible to Copilot. Only
    # double-quoted globs in a block list are parsed; single quotes and the inline
    # ["a","b"] form are not.
    if [ -z "$globs" ]; then
        echo "sync-instructions: $rule has no double-quoted glob under a paths: block" >&2
        exit 1
    fi

    case "$globs" in
        *,,* | ,* | *,)
            echo "sync-instructions: $rule produced a malformed applyTo list: $globs" >&2
            exit 1
            ;;
    esac


    body="$(awk 'NR == 1 && $0 == "---" { inside = 1; next } inside && $0 == "---" { inside = 0; body = 1; next } body' "$rule")"

    # An empty body means the closing fence was not exactly `---` (a trailing space is
    # enough). Left alone it writes a mirror with frontmatter and no rules, and
    # `--check` still passes because it compares generated output to generated output.
    if [ -z "$body" ]; then
        echo "sync-instructions: $rule produced an empty body; check its closing --- fence" >&2
        exit 1
    fi

    # Copilot cannot open a Claude Code path, so a rule that sends the reader to a
    # sibling rule sends it nowhere. Rewrite those three reference forms as the body
    # is staged, and leave the SOURCE rule alone: `.claude/rules/*.md` and `CLAUDE.md`
    # are the right paths for Claude Code, which is the only tool that reads them.
    #
    # Scoped to the rule bodies on purpose, NOT to the repo-wide mirror. In `AGENTS.md`
    # a `.claude/` mention is the subject of a sentence rather than a file to open (the
    # row of the topology table that exists to say where each tool's copy lives), so
    # rewriting it would turn a true statement into a false one. The generator's own
    # provenance banner keeps the real source path for the same reason: its whole job
    # is to say which file to edit instead of this one.
    #
    # Substitutions are literal and order-independent, so the output is deterministic
    # and `--check` cannot flap.
    body="$(
        printf '%s\n' "$body" | sed \
            -e 's|`\.claude/rules/\([a-z][a-z-]*\)\.md`|`.github/instructions/\1.instructions.md`|g' \
            -e 's|`CLAUDE\.md`|`AGENTS.md`|g' \
            -e 's|(`\.claude/agents/[a-z0-9][a-z0-9-]*\.md`)|(a Claude Code agent definition; Copilot has no equivalent, so apply those criteria by hand)|g'
    )"

    {
        echo "---"
        printf 'applyTo: "%s"\n' "$globs"
        echo "---"
        echo
        banner "$rule"
        printf '%s\n' "$body"
    } >"$target"
done

# Hand-authored, not generated: `review.instructions.md` is the reviewer checklist Copilot code
# review reads, and it has no `.claude/rules/` counterpart because Claude does not need it. Staging
# it as a pass-through is what keeps it alive: the write path below deletes every
# `*.instructions.md` before copying the staging tree back, and `--check` diffs the two directories
# recursively, so a file present in one and absent from the other is either deleted on the next run
# or reported as drift. Copying it in makes both operations no-ops for this file.
#
# It is deliberately NOT generated from a rule. `paths: ['**']` in a Claude rule is treated as no
# `paths:` at all, so the checklist would load into every Claude session, and a session authoring
# code does not need the list of things a reviewer should flag.
for passthrough in review; do
    source_file=".github/instructions/$passthrough.instructions.md"
    [ -f "$source_file" ] || continue
    cp "$source_file" "$STAGE/.github/instructions/$passthrough.instructions.md"
done

if [ "$CHECK" -eq 1 ]; then
    if diff -r -q "$STAGE/.github/instructions" .github/instructions >/dev/null 2>&1; then
        echo "sync-instructions: mirrors are up to date"
        exit 0
    fi

    echo "sync-instructions: the .github mirrors are out of date. Run bin/sync-instructions and commit the result." >&2
    diff -r -u .github/instructions "$STAGE/.github/instructions" || true
    exit 1
fi

mkdir -p .github/instructions
rm -f .github/instructions/*.instructions.md
cp "$STAGE"/.github/instructions/*.instructions.md .github/instructions/

echo "sync-instructions: wrote $(ls -1 .github/instructions | wc -l | tr -d ' ') path-scoped mirrors"
