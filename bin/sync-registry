#!/usr/bin/env python3
"""Regenerate docs/component-registry.md from lib/ui/components/.

Why this exists
---------------
The registry is what `CLAUDE.md` tells every agent to read before writing a widget, so that a
screen reaches for a component that exists instead of scaffolding a second one. It only works if
it describes what is on disk, and hand-maintained it does not: it was found listing 27 components
at paths that do not exist while 12 real ones appeared nowhere, and it drifted again the moment
the next component was added.

So it is generated, and `bin/check` verifies it is current the same way it verifies the .github
mirrors. A registry that can be wrong is worse than no registry, because it is trusted.

Usage
-----
    bin/sync-registry            rewrite the file
    bin/sync-registry --check    exit 1 if it is out of date, print nothing on success
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COMPONENTS = ROOT / "lib" / "ui" / "components"
LAYOUTS = ROOT / "lib" / "ui" / "layouts"
TARGET = ROOT / "docs" / "component-registry.md"


def first_prose_line(lines: list[str], class_line: int) -> str:
    """The first plain sentence of the doc block directly above the class declaration."""
    start = class_line - 1
    while start >= 0 and (lines[start].strip().startswith("///") or lines[start].strip().startswith("@")):
        start -= 1
    for line in lines[start + 1 : class_line]:
        text = line.strip()
        if text.startswith("///") and len(text) > 6 and not text.startswith("/// #"):
            body = text[4:].strip().replace("**", "")
            # Skip the bold-name heading `**Card**` that several components open with.
            if body and not re.fullmatch(r"[A-Z][A-Za-z]+", body):
                return body
    return ""


def read_component(directory: Path) -> tuple[str, str, str, str, str, str] | None:
    source_file = directory / f"{directory.name}.dart"
    if not source_file.exists():
        return None

    source = source_file.read_text()
    lines = source.split("\n")
    match = re.search(r"^class (\w+) extends", source, re.M)
    if match is None:
        return None

    name = match.group(1)
    class_line = next(i for i, line in enumerate(lines) if line.startswith(f"class {name} extends"))
    variants = ", ".join(sorted(set(re.findall(r"^enum (\w+)", source, re.M)))) or "-"
    recipe = "yes" if (directory / f"{directory.name}.recipe.dart").exists() else "no"
    preview = "yes" if (directory / f"{directory.name}.preview.dart").exists() else "**NO**"
    return directory.name, name, variants, recipe, preview, first_prose_line(lines, class_line)


def read_layout(path: Path) -> tuple[str, str, str]:
    source = path.read_text()
    lines = source.split("\n")
    names = re.findall(r"^class (\w+) extends", source, re.M)
    public = [n for n in names if not n.startswith("_")]
    first = next((i for i, line in enumerate(lines) if line.startswith(f"class {public[0]} extends")), 0)
    return path.name, ", ".join(f"`{n}`" for n in public), first_prose_line(lines, first)


def render() -> str:
    rows = [row for row in (read_component(d) for d in sorted(COMPONENTS.iterdir()) if d.is_dir()) if row]
    layouts = [read_layout(f) for f in sorted(LAYOUTS.glob("*.dart"))]

    out = [
        "---",
        "generated: by `bin/sync-registry` from `lib/ui/components/` and `lib/ui/layouts/`",
        "source: this app's own component library",
        "---",
        "",
        "# Component Registry",
        "",
        "Every component this app owns, so that a screen reaches for one that exists instead of",
        "scaffolding a second one. `CLAUDE.md` requires reading this before writing any widget, which",
        "only works if it describes what is actually on disk.",
        "",
        "**Do not edit this file.** Run `bin/sync-registry` after adding or changing a component;",
        "`bin/check` fails when it is out of date. It was hand-maintained once and drifted by 27",
        "phantom entries, then drifted again on the very next component added. A registry that can be",
        "wrong is worse than no registry, because it is trusted.",
        "",
        "## Look in `magic_starter` first",
        "",
        "The generic layer lives in the package, not here: `MSButton`, `MSInput`, `MSSelect`,",
        "`MSCheckbox`, `MSSwitch`, `MSCard`, `MSBadge`, `MSTabs`, `MSSegmentedControl`,",
        "`MSBottomSheet`, `MSEmptyState`, `MSPageScaffold`, `MSPageHeader`, `MSPageContainer` and the",
        "rest of its 37. A component belongs in this app only when it encodes something about depools",
        "that a generic library could not: a lot with an expiry, a count line with a variance, a",
        "location with a depth.",
        "",
        "## The components this app owns",
        "",
        "| Folder | Class | Variant enums | Recipe | Preview | What it is |",
        "|---|---|---|---|---|---|",
    ]
    for folder, name, variants, recipe, preview, doc in rows:
        out.append(f"| `{folder}/` | `{name}` | {variants} | {recipe} | {preview} | {doc} |")

    out += [
        "",
        f"{len(rows)} components. A `**NO**` in the Preview column is a rule violation, not a note:",
        "`.claude/rules/design.md` requires one preview per component.",
        "",
        "## Layout infrastructure (not in the component library)",
        "",
        "These live in `lib/ui/layouts/` because they are page structure rather than visual",
        "components, and they have no preview: the catalog renders screens without a shell, which is",
        "the one place they do not apply.",
        "",
        "| File | Classes | What it is |",
        "|---|---|---|",
    ]
    for filename, classes, doc in layouts:
        out.append(f"| `{filename}` | {classes} | {doc} |")

    return "\n".join(out) + "\n"


def main() -> int:
    rendered = render()
    if "--check" in sys.argv:
        current = TARGET.read_text() if TARGET.exists() else ""
        if current != rendered:
            print("component-registry.md is out of date. Run bin/sync-registry.", file=sys.stderr)
            return 1
        return 0

    TARGET.write_text(rendered)
    count = rendered.count("\n| `")
    print(f"sync-registry: wrote {TARGET.relative_to(ROOT)} ({count} rows)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
